  "material_scope_amendment_proposal": {
    "status": "PROPOSAL_NOT_AUTHORIZED",
    "recommended": "Resource-bounded schema helper process, preserving the real Draft 2020-12 library and existing SDK ABI; do not weaken the memory limit or substitute a partial schema checker.",
    "alternative": "Keep schema in-process only after a separately reviewed dependency replacement or allocator/regex-workspace remediation demonstrates complete bounded allocation coverage.",
    "worker_proposal": {
      "boundary": "Only schema validation of the same owned immutable JSON bytes; fixed trusted schemas; bounded verdict response. Parent still performs strict parse and all bounded semantic/geometry validation.",
      "memory_limit_MiB": 128,
      "deadline_ms": 5000,
      "request_max_bytes": 1048576,
      "reply_max_bytes": 128,
      "workers_per_context": 1,
      "windows": "Owned process handle and Job Object memory/active-process/deadline cleanup; no arbitrary PATH binary lookup.",
      "linux": "Owned child plus address-space/CPU limits, bounded pipes, timeout/kill/wait cleanup; no accidental inherited descriptors.",
      "failure": "Crash, timeout, truncated reply or version/hash mismatch produces typed failure and zero published model; no unbounded respawn/retry.",
      "network": "Resolvers only serve fixed compiled/local schema documents; no URI fetching. Resource isolation is not claimed to be a full hostile-code sandbox.",
      "trust": "Trusted helper executable supplied by the build; do not execute asset-provided paths or commands.",
      "impact": "Adds a helper artifact/process lifetime/IPC to the previously proposed native in-process design; packaging and deployment implications need owner scope acceptance.",
      "additional_exact_paths": [
        "src/validation/schema_worker_main.cpp",
        "src/validation/schema_worker_client.hpp",
        "src/validation/schema_worker_client.cpp",
        "src/validation/schema_worker_protocol.hpp",
        "src/validation/schema_worker_windows.cpp",
        "src/validation/schema_worker_linux.cpp",
        "tests/assets/schema_worker_tests.cpp"
      ],
      "proposed_c1_path_count": 41
    },
