{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARS Native 2D Rig v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coordinate_space",
    "canvas",
    "parameters",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "coordinate_space": {
      "const": "canvas_px"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "default",
          "min",
          "max"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {
            "type": "number"
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "z_index",
          "atlas_rect_px",
          "vertices_px",
          "uv",
          "triangles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "z_index": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000
          },
          "atlas_rect_px": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "pivot_normalized": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "vertices_px": {
            "type": "array",
            "minItems": 3,
            "maxItems": 65535,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "uv": {
            "type": "array",
            "minItems": 3,
            "maxItems": 65535,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "triangles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "deform_targets": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parameter",
                "vertex_deltas_px"
              ],
              "properties": {
                "parameter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "vertex_deltas_px": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
