@PACKAGE_INIT@
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@")
    set(AvatarRuntime_FOUND FALSE)
    set(AvatarRuntime_NOT_FOUND_MESSAGE "This SDK binary targets @CMAKE_SYSTEM_NAME@ only")
    return()
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/AvatarRuntimeTargets.cmake")
set(AvatarRuntime_RuntimeCore_FOUND TRUE)
set(AvatarRuntime_PROFILE "@ARS_SDK_PROFILE@")
if(AvatarRuntime_PROFILE STREQUAL "ISOLATED_PUBLIC_CPU_ASSETS" OR
   AvatarRuntime_PROFILE STREQUAL "OPT_IN_PUBLIC_D3D11_HOST")
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(AvatarRuntime_FOUND FALSE)
        set(AvatarRuntime_NOT_FOUND_MESSAGE "This CPU profile requires a Windows x64 consumer")
        return()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/AvatarRuntimeCpuHelpers.cmake")
endif()
set(AvatarRuntime_ABI_VERSION 65536)
check_required_components(AvatarRuntime)
