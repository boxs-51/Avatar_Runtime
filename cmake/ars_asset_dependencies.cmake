# Built-in GLB CPU validator follows glTF 2.0.1 at this immutable spec revision.
# It reuses the locked PNG/JSON primitives below; no additional decoder dependency.
set(ARS_GLB_SPEC_COMMIT 8e798b02d254cea97659a333cfcb20875b62bdd4)
# Immutable, private dependencies. Cache contents are verified before extraction;
# missing cache is a hard failure unless explicit configure-time fetching is on.
set(ARS_ASSET_DEP_CACHE "${CMAKE_BINARY_DIR}/dependency-cache" CACHE PATH "Verified source archive cache")
option(ARS_ASSET_FETCH_DEPS "Allow downloading exact hashed dependency archives at configure time" OFF)
function(ars_asset_dependency name repo sha digest)
    set(archive "${ARS_ASSET_DEP_CACHE}/${name}.zip")
    if(NOT EXISTS "${archive}")
        if(NOT ARS_ASSET_FETCH_DEPS)
            message(FATAL_ERROR "Missing verified ${name}.zip in ARS_ASSET_DEP_CACHE (offline mode)")
        endif()
        file(MAKE_DIRECTORY "${ARS_ASSET_DEP_CACHE}")
        file(DOWNLOAD "https://codeload.github.com/${repo}/zip/${sha}" "${archive}"
            EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON STATUS outcome)
        list(GET outcome 0 code)
        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Pinned dependency download failed: ${name}: ${outcome}")
        endif()
    endif()
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL digest)
        message(FATAL_ERROR "Corrupted or substituted dependency cache: ${name}")
    endif()
    set(destination "${CMAKE_BINARY_DIR}/asset-deps/${name}-${sha}")
    file(MAKE_DIRECTORY "${destination}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
    get_filename_component(project_name "${repo}" NAME)
    set(${name}_SOURCE "${destination}/${project_name}-${sha}" PARENT_SCOPE)
endfunction()
